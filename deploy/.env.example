# Copy to deploy/.env and fill in. Never commit .env.
# Required: BETTER_AUTH_SECRET and OFFICE_MASTER_KEY (Compose refuses to start without them).
# Everything else has a default that serves the office at https://localhost.

# Public hostname for Caddy. `localhost` uses Caddy's internal CA (local dev); a real
# hostname pointing at this machine gets a Let's Encrypt certificate.
OFFICE_DOMAIN=localhost

# Host ports Caddy publishes. If you change the HTTPS port, set OFFICE_PUBLIC_URL to match
# (e.g. https://localhost:8443).
# OFFICE_HTTP_PORT=80
# OFFICE_HTTPS_PORT=443

# 32 random bytes, base64. Encrypts per-user API keys at rest (SPEC §8). Generate: openssl rand -base64 32
OFFICE_MASTER_KEY=

# Where the office listens (Compose sets these; for bare-metal installs adjust here).
OFFICE_PORT=4600
OFFICE_HOST=0.0.0.0
OFFICE_DATA_DIR=/data

# Externally reachable origin, used for links, OAuth callbacks and Origin checks. It must equal
# the origin in the browser's address bar. Compose defaults it to https://$OFFICE_DOMAIN;
# a bare `bun` server defaults to http://localhost:$OFFICE_PORT.
# OFFICE_PUBLIC_URL=https://office.example.com

# pino level: fatal, error, warn, info, debug, trace, silent.
OFFICE_LOG_LEVEL=info

# Optional: path to the built web client if not apps/web/dist.
# OFFICE_WEB_DIST=
# Optional: how long graceful shutdown waits for in-flight requests (ms).
# OFFICE_SHUTDOWN_TIMEOUT_MS=10000

# Better Auth secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub social login for humans.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The first person to register becomes owner. Afterwards, registration (email or GitHub)
# needs an invite link from an owner/admin unless this is true, which lets anyone register as member.
OFFICE_OPEN_SIGNUP=false

# GitHub App for boards/webhooks (created through the setup page; fill after creation).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LiveKit (profile: media).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Postgres (profile: pg). Leave empty to use SQLite.
POSTGRES_USER=office
POSTGRES_PASSWORD=
POSTGRES_DB=office
