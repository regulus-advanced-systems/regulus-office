# Copy to deploy/.env and fill in, or run scripts/setup.sh, which creates it (mode 600), generates
# both secrets and never overwrites existing ones. Never commit .env.
# Required: BETTER_AUTH_SECRET and OFFICE_MASTER_KEY (Compose refuses to start without them).
# Everything else has a default that serves the office at https://localhost.

# Public hostname for Caddy. `localhost` uses Caddy's internal CA (local dev); a real
# hostname pointing at this machine gets a Let's Encrypt certificate.
OFFICE_DOMAIN=localhost

# Host ports Caddy publishes. If you change the HTTPS port, set OFFICE_PUBLIC_URL to match
# (e.g. https://localhost:8443).
# OFFICE_HTTP_PORT=80
# OFFICE_HTTPS_PORT=443

# 32 random bytes, base64. Encrypts per-user API keys at rest (SPEC §8). Generate: openssl rand -base64 32
# The value is exactly 44 characters ending in "="; a pasted value that lost characters will not start.
# Keep a copy: replacing it makes stored API keys and the GitHub connection unreadable.
OFFICE_MASTER_KEY=

# Where the office listens (Compose sets these; for bare-metal installs adjust here).
OFFICE_PORT=4600
OFFICE_HOST=0.0.0.0
OFFICE_DATA_DIR=/data

# Externally reachable origin, used for links, OAuth callbacks and Origin checks. It must equal
# the origin in the browser's address bar. Compose defaults it to https://$OFFICE_DOMAIN;
# a bare `bun` server defaults to http://localhost:$OFFICE_PORT.
# OFFICE_PUBLIC_URL=https://office.example.com

# Docker runner backend (SPEC §8). Only the docker-proxy service mounts the Docker socket; the
# office reaches a filtered Engine API at DOCKER_HOST=tcp://docker-proxy:2375 (set by Compose).
# Host socket path, e.g. /run/user/1000/docker.sock for rootless Docker.
# DOCKER_SOCKET=/var/run/docker.sock
# Runner containers may only bind-mount host paths under this directory (named volumes are fine).
# OFFICE_RUNNER_BIND_ROOT=/srv/office
# The proxy runs as root with no capabilities; set 65534:<docker group id> to run it unprivileged.
# DOCKER_PROXY_USER=0:0
# Runner image (build it with: docker compose --profile build-only build runner-image).
# OFFICE_RUNNER_IMAGE=ghcr.io/regulus-advanced-systems/regulus-office-runner:latest
# The office as runners reach it on the `runners` network (Claude hooks, statusline forwarder).
# OFFICE_RUNNER_OFFICE_URL=http://office:4600
# Before a Claude Code robot starts, trust its own office-created worktree in the runner's
# ~/.claude.json so Claude's "trust this folder?" dialog does not hold it (default true).
# OFFICE_CLAUDE_TRUST_WORKTREES=true
# Optional runner limits: memory (e.g. 4g), CPUs (e.g. 2), max processes (default 4096).
# OFFICE_DOCKER_RUNNER_MEMORY=
# OFFICE_DOCKER_RUNNER_CPUS=
# OFFICE_DOCKER_RUNNER_PIDS=4096

# Nightly database backups by the `backup` service (README "Backups and restore"). They go to a
# host directory, not the office-data volume, so deleting the volume keeps them. The directory
# must exist, owned by uid 1000 with mode 700 (scripts/setup.sh creates it; --backup-dir to move it).
# Relative paths are relative to deploy/. Copy it off the machine too.
# OFFICE_BACKUP_HOST_DIR=./backups
# Daily run time, HH:MM in UTC.
# OFFICE_BACKUP_TIME=03:00
# Delete backups older than this many days (0 keeps all).
# OFFICE_BACKUP_RETENTION_DAYS=14

# pino level: fatal, error, warn, info, debug, trace, silent.
OFFICE_LOG_LEVEL=info

# Optional: path to the built web client if not apps/web/dist.
# OFFICE_WEB_DIST=
# Optional: how long graceful shutdown waits for in-flight requests (ms).
# OFFICE_SHUTDOWN_TIMEOUT_MS=10000

# Better Auth secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional GitHub social login for humans.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The first person to register becomes owner. Afterwards, registration (email or GitHub)
# needs an invite link from an owner/admin unless this is true, which lets anyone register as member.
OFFICE_OPEN_SIGNUP=false

# Office GitHub App. Normally leave these empty and use Settings -> GitHub -> "Create GitHub App…",
# which stores the app encrypted in the database (needs OFFICE_MASTER_KEY). Set GITHUB_APP_ID and
# GITHUB_APP_PRIVATE_KEY (PEM; "\n" escapes are fine) only to override it from the environment.
GITHUB_APP_ID=
# Optional: the app's client ID, used as the JWT issuer (GitHub's recommendation); else the app ID.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
# The env app's webhook secret; webhooks to /api/github/webhook are refused without it.
GITHUB_WEBHOOK_SECRET=

# Issue/PR boards: poll GitHub (conditional requests) while no webhooks arrive, every N seconds (30-3600).
OFFICE_GITHUB_POLLING=true
OFFICE_GITHUB_POLL_SECONDS=60

# The compound (rooms on a grid): a new room's build phase in seconds (0-600), and the
# compound's size in tiles a side (48-256; read only when the compound is first created).
OFFICE_ROOM_BUILD_SECONDS=20
OFFICE_COMPOUND_SIZE=64

# LiveKit (profile: media).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Postgres (profile: pg). Leave empty to use SQLite.
POSTGRES_USER=office
POSTGRES_PASSWORD=
POSTGRES_DB=office
