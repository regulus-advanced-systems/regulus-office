#!/bin/sh
# Fake `claude` for the agents e2e (tests/e2e/agents.e2e.ts). It is NOT Claude Code, has no
# network access beyond the office's hook URL, and never reads or writes any credentials.
#
# Like apps/server/src/agents/hooks/testing/fake-claude.sh it reads the --settings file the
# Claude adapter generated and runs the registered hooks the way Claude Code does
# (claude-hooks.sh, next to this script): command hooks get the payload on stdin, and http hooks
# to a private or link-local address are refused with Claude Code's own error (#162). Payloads:
#   SessionStart, UserPromptSubmit, PreToolUse(Edit), then (for a "[hold the edit]" prompt,
#   once the spec creates $HOME/.fake-claude-ask) PermissionRequest(Edit), whose response is
#   held by the office until someone answers the permission prompt.
# On "allow" it makes the edit, commits it in its worktree (the cwd) and posts PostToolUse and
# Stop. Then it idles so the tmux session stays alive across an office restart.
# `claude auth status` (the office's login check, credentials/cli-status.ts): report a login
# without touching any account, so the spawn dialog offers "Your Claude Code login". It takes
# a moment, like the real CLI, so the check is still running when the spec spawns (#126).
#
# Diagnostics (#130): its stderr, plus a timestamped trace of what it did and each hook's HTTP
# result, is appended to $HOME/fake-claude.stderr, which the spec collects when a test fails. The
# trace never holds the hook token (it stays in the adapter's 0600 headers file).
trace_file="${HOME:-/tmp}/fake-claude.stderr"
exec 3>&1 2>>"$trace_file"
trace() { printf '%s [%s] %s\n' "$(date -u +%H:%M:%S.%N | cut -c1-12)" "$$" "$*" >&2; }
trace "start: $(printf '%s ' "$@" | cut -c1-80)"
if [ "$1" = auth ] && [ "$2" = login ]; then
  # The login terminal (#164): a long sign-in link (the terminal wraps it), then a prompt
  # that waits for a pasted code. No account and no network are involved. While it waits,
  # `auth status` says "not logged in", so the office keeps the login terminal open.
  pending="${HOME:-/tmp}/.fake-claude-login-pending"
  : > "$pending"
  printf 'Browser didn'"'"'t open? Use the url below to sign in:\n\n'
  printf 'https://claude.ai/oauth/authorize?code=true&client_id=fake-e2e-client&response_type=code'
  printf '&redirect_uri=https%%3A%%2F%%2Fplatform.claude.com%%2Foauth%%2Fcode%%2Fcallback&state=fakee2e\n\n'
  printf 'Paste code here if prompted > '
  read -r code
  trace "login code read (${#code} chars)"
  rm -f "$pending"
  exit 0
fi
if [ "$1" = auth ]; then
  sleep 2
  if [ -e "${HOME:-/tmp}/.fake-claude-login-pending" ]; then
    echo '{"loggedIn":false}'
    trace "auth status answered: login pending"
    exit 1
  fi
  echo '{"loggedIn":true,"authMethod":"fake"}'
  trace "auth status answered"
  exit 0
fi
# Print mode (#155 workflow henchmen: `claude -p ... <prompt>`): no hooks, no session. It records
# the flags it got (never the prompt), probes what the sandbox allows (writing to the checkout,
# git remotes to push to, GitHub tokens in its env), and answers with a result object whose
# structured_output is a review with one inline comment on the first changed line of the diff
# in the prompt, one comment outside the diff, and two labels.
case " $* " in
*" -p "* | *" --print "*)
  for last in "$@"; do :; done
  pjson() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '; }
  : > "${HOME:-/tmp}/fake-claude-print.args"
  n=0
  for a in "$@"; do
    n=$((n + 1))
    if [ "$n" -lt "$#" ]; then
      printf '%s\n' "$(printf '%s' "$a" | head -c 300 | tr '\n' ' ')" >> "${HOME:-/tmp}/fake-claude-print.args"
    fi
  done
  if (: > "$PWD/.fake-claude-write") 2>/dev/null; then write=allowed; else write=denied; fi
  remotes=$(git remote 2>/dev/null | wc -l | tr -d ' ')
  if git push --quiet origin HEAD:refs/heads/fake-claude 2>/dev/null; then push=allowed; else push=denied; fi
  tokens=$(env | grep -c 'gh[pousr]_' || true)
  if [ -n "$ANTHROPIC_API_KEY" ]; then key=yes; else key=no; fi
  # The first added line of the diff: "<path>:<line in the new file>".
  first=$(printf '%s\n' "$last" | awk '
    /^\+\+\+ b\// { f = substr($0, 7); next }
    /^@@ / { match($0, /\+[0-9]+/); n = substr($0, RSTART + 1, RLENGTH - 1); h = 1; next }
    h && /^\+/ { print f ":" n; exit }
    h && /^ / { n++ }')
  path=${first%:*}
  line=${first##*:}
  trace "print mode: write=$write push=$push remotes=$remotes"
  summary="Fake review (not Claude Code). write: $write, push: $push, remotes: $remotes, github tokens in env: $tokens, model key: $key. cc @octocat"
  # A prompt-injection stand-in: "LEAK_KEY:<form>" in the prompt (e.g. in the PR body) makes
  # the fake put its model key into the review, as a henchman tricked into reading
  # /proc/self/environ would. The office must never post it (#155).
  leak=$(printf '%s\n' "$last" | sed -n 's/.*LEAK_KEY:\([a-z0-9]*\).*/\1/p' | head -n 1)
  environ_key=$(cat /proc/self/environ 2>/dev/null | tr '\0' '\n' | sed -n 's/^ANTHROPIC_API_KEY=//p' | head -n 1)
  case "$leak" in
  plain) summary="$summary Key: $environ_key" ;;
  zw) summary="$summary Key: $(printf '%s' "$environ_key" | sed 's/./&\xe2\x80\x8b/g')" ;;
  b64) summary="$summary Key: $(printf 'KEY=%s' "$environ_key" | base64 | tr -d '\n')" ;;
  esac
  printf '{"type":"result","subtype":"success","is_error":false,"result":"","session_id":"fake","total_cost_usd":0.0123,'
  printf '"usage":{"input_tokens":1200,"output_tokens":340,"cache_read_input_tokens":10,"cache_creation_input_tokens":5},'
  printf '"structured_output":{"summary":"%s","verdict":"request_changes",' "$(pjson "$summary")"
  printf '"comments":[{"path":"%s","line":%s,"body":"Fake inline note"},' "$(pjson "$path")" "${line:-1}"
  printf '{"path":"not-in-diff.txt","line":999,"body":"Outside the diff"}],'
  printf '"labels":["needs-work","not-allowed"]}}\n'
  exit 0
  ;;
esac
settings=""
session=""
prompt=""
while [ $# -gt 0 ]; do
  case "$1" in
    --settings) settings="$2"; shift 2 ;;
    --session-id|--resume) session="$2"; shift 2 ;;
    --model|--effort) shift 2 ;;
    -*) shift ;;
    *) prompt="$1"; shift ;;
  esac
done
echo "FAKE CLAUDE (not Claude Code) session $session"
# Like Claude Code (2.1.x) on its prompt screen: turn on any-event mouse tracking in SGR
# encoding. tmux passes it on to the attached client, i.e. the browser's xterm (#164).
printf '\033[?1000h\033[?1002h\033[?1003h\033[?1006h'
trace "session $session in $PWD"
[ -r "$settings" ] || { echo "FAKE CLAUDE no settings"; trace "no settings"; exec sleep infinity; }
. "$(dirname "$0")/claude-hooks.sh"
claude_hooks_trace() { trace "$@"; }
# A blocked or failed hook shows in the pane (fd 3) like Claude Code's "<Event> hook error: ...".
claude_hooks_error() { echo "$*" >&3; trace "$*"; }
claude_hooks_init "$settings"

# hook <json>: run the hook registered for the payload's event, print its output.
hook() {
  claude_hook "$(printf '%s' "$1" | sed -n 's/.*"hook_event_name":"\([A-Za-z]*\)".*/\1/p')" "$1"
}
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '; }

file="$PWD/FAKE_CLAUDE.md"
base="\"session_id\":\"$session\",\"cwd\":\"$PWD\""
edit="{\"file_path\":\"$file\",\"old_string\":\"\",\"new_string\":\"hello from the fake agent\"}"

hook "{$base,\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}" > /dev/null
if [ -z "$prompt" ]; then
  # Spawned idle (#142), as meeting members are (#50): take each prompt typed into the
  # terminal (the office sends one line per prompt). A meeting turn names its notes file,
  # `.meeting/turns/<file>`: write it, plus the panel's review when the turn asks for one, and
  # commit a change when the turn says to commit. UserPromptSubmit and Stop frame each turn.
  echo "FAKE CLAUDE waiting for prompts"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    hook "{$base,\"hook_event_name\":\"UserPromptSubmit\",\"prompt\":\"$(json_escape "$(printf '%s' "$line" | cut -c1-200)")\"}" > /dev/null
    who=$(printf '%s' "$line" | sed -n 's/.*You are \([A-Za-z]*\( [0-9]\)\{0,1\}\) in a meeting.*/\1/p')
    notes=$(printf '%s' "$line" | sed -n 's/.*`\(\.meeting\/turns\/[^`]*\)`.*/\1/p')
    trace "meeting turn: ${who:-?} -> ${notes:-no notes file}"
    sleep 2
    if [ -n "$notes" ]; then
      mkdir -p "$(dirname "$notes")"
      printf '%s (fake, not Claude Code): keep the board sync cache in memory, five minutes per entry.\n' "${who:-Henchman}" > "$notes"
      case "$line" in *".meeting/review.md"*)
        printf 'Fake panel review (not Claude Code): no blocking findings.\n' > .meeting/review.md ;;
      esac
      case "$line" in *"commit the change on the current branch"*)
        printf 'export const boardCache = new Map<string, unknown>();\n' > MEETING_CACHE.ts
        git add MEETING_CACHE.ts &&
          git -c user.name="Fake Claude" -c user.email=fake-claude@example.invalid \
            commit -q -m "Add the board sync cache the meeting chose" &&
          echo "FAKE CLAUDE committed $(git rev-parse --short HEAD)" ;;
      esac
    fi
    hook "{$base,\"hook_event_name\":\"Stop\",\"stop_hook_active\":false}" > /dev/null
  done
  exec sleep infinity
fi
echo "FAKE CLAUDE prompt: $prompt"
sleep 1
hook "{$base,\"hook_event_name\":\"UserPromptSubmit\",\"prompt\":\"$(json_escape "$prompt")\"}" > /dev/null
sleep 1
echo "FAKE CLAUDE editing $file"
hook "{$base,\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\",\"tool_use_id\":\"toolu_fake_1\",\"tool_input\":$edit}" > /dev/null
# With "[hold the edit]" in the prompt, keep editing until the spec has seen the henchman type
# (#159): it follows a new action only once it has held for 1.5 s, and a slow CI browser sees
# the status late and draws few frames, so a fixed pause was sometimes over before the typing
# clip had moved a bone (#179). The spec says when by creating $ask; after two minutes without
# it, ask anyway (a manual run). Other prompts (the queued tasks) edit for 6 s.
case "$prompt" in
  *"[hold the edit]"*)
    ask="${HOME:-/tmp}/.fake-claude-ask"
    ticks=600
    while [ ! -e "$ask" ] && [ "$ticks" -gt 0 ]; do sleep 0.2; ticks=$((ticks - 1)); done
    trace "asking for permission ($([ -e "$ask" ] && echo "told to" || echo "not told"))"
    rm -f "$ask"
    ;;
  *) sleep 6 ;;
esac
echo "FAKE CLAUDE asking for permission"
answer=$(hook "{$base,\"hook_event_name\":\"PermissionRequest\",\"tool_name\":\"Edit\",\"tool_input\":$edit}")
if printf '%s' "$answer" | grep -q '"behavior" *: *"allow"'; then
  echo "FAKE CLAUDE allowed"
  printf 'hello from the fake agent\n' > "$file"
  git add FAKE_CLAUDE.md &&
    git -c user.name="Fake Claude" -c user.email=fake-claude@example.invalid \
      commit -q -m "Add FAKE_CLAUDE.md" &&
    echo "FAKE CLAUDE committed $(git rev-parse --short HEAD)"
  hook "{$base,\"hook_event_name\":\"PostToolUse\",\"tool_name\":\"Edit\",\"tool_use_id\":\"toolu_fake_1\",\"tool_input\":$edit,\"tool_response\":{\"filePath\":\"$file\"}}" > /dev/null
else
  echo "FAKE CLAUDE not allowed: $answer"
fi
hook "{$base,\"hook_event_name\":\"Stop\",\"stop_hook_active\":false}" > /dev/null
echo "FAKE CLAUDE DONE"
trace "done"
exec sleep infinity
