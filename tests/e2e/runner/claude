#!/bin/sh
# Fake `claude` for the agents e2e (tests/e2e/agents.e2e.ts). It is NOT Claude Code, has no
# network access beyond the office's hook URL, and never reads or writes any credentials.
#
# Like apps/server/src/agents/hooks/testing/fake-claude.sh it reads the --settings file the
# Claude adapter generated and runs the registered hooks the way Claude Code does
# (claude-hooks.sh, next to this script): command hooks get the payload on stdin, and http hooks
# to a private or link-local address are refused with Claude Code's own error (#162). Payloads:
#   SessionStart, UserPromptSubmit, PreToolUse(Edit), then PermissionRequest(Edit), whose
#   response is held by the office until someone answers the permission prompt.
# On "allow" it makes the edit, commits it in its worktree (the cwd) and posts PostToolUse and
# Stop. Then it idles so the tmux session stays alive across an office restart.
# `claude auth status` (the office's login check, credentials/cli-status.ts): report a login
# without touching any account, so the spawn dialog offers "Your Claude Code login". It takes
# a moment, like the real CLI, so the check is still running when the spec spawns (#126).
#
# Diagnostics (#130): its stderr, plus a timestamped trace of what it did and each hook's HTTP
# result, is appended to $HOME/fake-claude.stderr, which the spec collects when a test fails. The
# trace never holds the hook token (it stays in the adapter's 0600 headers file).
trace_file="${HOME:-/tmp}/fake-claude.stderr"
exec 3>&1 2>>"$trace_file"
trace() { printf '%s [%s] %s\n' "$(date -u +%H:%M:%S.%N | cut -c1-12)" "$$" "$*" >&2; }
trace "start: $(printf '%s ' "$@" | cut -c1-80)"
if [ "$1" = auth ] && [ "$2" = login ]; then
  # The login terminal (#164): a long sign-in link (the terminal wraps it), then a prompt
  # that waits for a pasted code. No account and no network are involved. While it waits,
  # `auth status` says "not logged in", so the office keeps the login terminal open.
  pending="${HOME:-/tmp}/.fake-claude-login-pending"
  : > "$pending"
  printf 'Browser didn'"'"'t open? Use the url below to sign in:\n\n'
  printf 'https://claude.ai/oauth/authorize?code=true&client_id=fake-e2e-client&response_type=code'
  printf '&redirect_uri=https%%3A%%2F%%2Fplatform.claude.com%%2Foauth%%2Fcode%%2Fcallback&state=fakee2e\n\n'
  printf 'Paste code here if prompted > '
  read -r code
  trace "login code read (${#code} chars)"
  rm -f "$pending"
  exit 0
fi
if [ "$1" = auth ]; then
  sleep 2
  if [ -e "${HOME:-/tmp}/.fake-claude-login-pending" ]; then
    echo '{"loggedIn":false}'
    trace "auth status answered: login pending"
    exit 1
  fi
  echo '{"loggedIn":true,"authMethod":"fake"}'
  trace "auth status answered"
  exit 0
fi
settings=""
session=""
prompt=""
while [ $# -gt 0 ]; do
  case "$1" in
    --settings) settings="$2"; shift 2 ;;
    --session-id|--resume) session="$2"; shift 2 ;;
    --model|--effort) shift 2 ;;
    -*) shift ;;
    *) prompt="$1"; shift ;;
  esac
done
echo "FAKE CLAUDE (not Claude Code) session $session"
# Like Claude Code (2.1.x) on its prompt screen: turn on any-event mouse tracking in SGR
# encoding. tmux passes it on to the attached client, i.e. the browser's xterm (#164).
printf '\033[?1000h\033[?1002h\033[?1003h\033[?1006h'
trace "session $session in $PWD"
[ -r "$settings" ] || { echo "FAKE CLAUDE no settings"; trace "no settings"; exec sleep infinity; }
. "$(dirname "$0")/claude-hooks.sh"
claude_hooks_trace() { trace "$@"; }
# A blocked or failed hook shows in the pane (fd 3) like Claude Code's "<Event> hook error: ...".
claude_hooks_error() { echo "$*" >&3; trace "$*"; }
claude_hooks_init "$settings"

# hook <json>: run the hook registered for the payload's event, print its output.
hook() {
  claude_hook "$(printf '%s' "$1" | sed -n 's/.*"hook_event_name":"\([A-Za-z]*\)".*/\1/p')" "$1"
}
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '; }

file="$PWD/FAKE_CLAUDE.md"
base="\"session_id\":\"$session\",\"cwd\":\"$PWD\""
edit="{\"file_path\":\"$file\",\"old_string\":\"\",\"new_string\":\"hello from the fake agent\"}"

hook "{$base,\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}" > /dev/null
echo "FAKE CLAUDE prompt: $prompt"
sleep 1
hook "{$base,\"hook_event_name\":\"UserPromptSubmit\",\"prompt\":\"$(json_escape "$prompt")\"}" > /dev/null
sleep 1
echo "FAKE CLAUDE editing $file"
hook "{$base,\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\",\"tool_use_id\":\"toolu_fake_1\",\"tool_input\":$edit}" > /dev/null
# Long enough for the robot to show typing: it follows a new action only once it has held
# for 1.5 s (#159), and a slow CI browser sees the status late.
sleep 6
echo "FAKE CLAUDE asking for permission"
answer=$(hook "{$base,\"hook_event_name\":\"PermissionRequest\",\"tool_name\":\"Edit\",\"tool_input\":$edit}")
if printf '%s' "$answer" | grep -q '"behavior" *: *"allow"'; then
  echo "FAKE CLAUDE allowed"
  printf 'hello from the fake agent\n' > "$file"
  git add FAKE_CLAUDE.md &&
    git -c user.name="Fake Claude" -c user.email=fake-claude@example.invalid \
      commit -q -m "Add FAKE_CLAUDE.md" &&
    echo "FAKE CLAUDE committed $(git rev-parse --short HEAD)"
  hook "{$base,\"hook_event_name\":\"PostToolUse\",\"tool_name\":\"Edit\",\"tool_use_id\":\"toolu_fake_1\",\"tool_input\":$edit,\"tool_response\":{\"filePath\":\"$file\"}}" > /dev/null
else
  echo "FAKE CLAUDE not allowed: $answer"
fi
hook "{$base,\"hook_event_name\":\"Stop\",\"stop_hook_active\":false}" > /dev/null
echo "FAKE CLAUDE DONE"
trace "done"
exec sleep infinity
