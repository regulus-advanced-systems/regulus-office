{
  "name": "regulus-office",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@regulus/server' --filter '@regulus/web' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "@regulus/protocol": "workspace:*"
  }
}
