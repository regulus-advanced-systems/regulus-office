{
  "name": "@regulus/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Regulus Office server: HTTP, multiplayer rooms, PTY bridge, agents, GitHub, PM bridge",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "loadtest:building": "bun run scripts/loadtest-building.ts"
  },
  "dependencies": {
    "@colyseus/bun-websockets": "0.18.3",
    "@colyseus/core": "0.18.17",
    "@regulus/agent-adapters": "workspace:*",
    "@regulus/floor-layout": "workspace:*",
    "@regulus/protocol": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "0.45.3",
    "pino": "^10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.4",
    "drizzle-kit": "0.31.11"
  }
}
