#!/bin/bash
# office-runner-helper: the only privileged entry point of the linux-user runner
# backend (SPEC §8, docs/deploy/linux-user-runner.md). office-server runs it as
# `sudo -n office-runner-helper <verb> <args>`; it is installed root:root 0755
# at /usr/local/lib/office/office-runner-helper.
#
# Trust model: office-server may act as any office runner account
# (`office-u-<rid>`), which is what running agents for humans means. It must not
# be able to become root or any other account. Hence every argument is checked
# against a strict grammar before anything runs, root-level work is limited to
# account/tmux/cgroup/ACL plumbing, and everything else runs as the runner user
# (setpriv). Nothing here echoes stdin: it carries env and file contents that
# may hold secrets.
#
# Exit codes: 0 ok, 1 failure, 2 invalid arguments, 3 not found.
# Single-quoted scripts below are run by /bin/sh as the runner user, on purpose.
# shellcheck disable=SC2016
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly CONF=/etc/office/runner-helper.conf
readonly CGROUP_DIR=/sys/fs/cgroup/system.slice
readonly MARKER="Regulus Office runner"
readonly RID_RE='^[a-z0-9]{1,23}$'
readonly AID_RE='^[A-Za-z0-9_-]{1,64}$'
readonly SESSION_RE='^agent-[A-Za-z0-9_-]{1,64}$'
readonly CONF_PATH_RE='^(/[A-Za-z0-9._-]+)+$'
TMUX_DIR=/run/office/tmux
PROJECTS_ROOT=/srv/office/projects
WORKTREES_ROOT=/srv/office/worktrees
SERVER_USER=office

# Runs inside the agent's tmux pane or piped scope, as the runner user. Waits
# until the process sits in its own scope (exec adopts the pane pid after tmux
# forked it), then sources and deletes the 0600 env file and execs the agent.
readonly WRAPPER='unit=$1 envfile=$2 cwd=$3
shift 3
in_unit() {
  while IFS= read -r l; do case $l in "0::"*"/$unit") return 0 ;; esac; done </proc/self/cgroup
  return 1
}
i=0
until in_unit; do
  i=$((i + 1))
  if [ "$i" -gt 200 ]; then echo "office: $unit not ready" >&2; rm -f "$envfile"; exit 1; fi
  sleep 0.05
done
. "$envfile"
rm -f "$envfile"
cd "$cwd" || exit 1
exec "$@"'

die() {
  echo "office-runner-helper: $1" >&2
  exit "${2:-1}"
}

usage() {
  cat >&2 <<'EOF'
usage: office-runner-helper <verb> <args>
  provision <rid>                         create office-u-<rid>, HOME 0700, tmux server
  deprovision <rid>                       kill everything of office-u-<rid>, delete it
  mount-project <rid> <workdir>           ACL a project/worktree dir for office-u-<rid>
  exec <rid> <agentId> <cwd> -- <argv..>  tmux session agent-<agentId> in scope agent-<agentId>
                                          (stdin: env script, NUL-terminated)
  spawn-piped <rid> <agentId> <cwd> -- <argv..>
                                          piped process in scope agent-<agentId>.io-<n>
                                          (stdin: env script, NUL, then the process stdin)
  kill <rid> <agentId>                    kill the session and every agent-<agentId> scope
  sockets <rid> <agentId>                 "<pid> <inode>" for sockets of the agent's processes
  capture <rid> <session> <lines>         tmux capture-pane
  pane-title <rid> <session>              tmux pane title
  send-keys <rid> <session> <0|1> <text|raw>
                                          paste stdin into the pane (text = bracketed,
                                          raw = control keys), 1 = press Enter after
  has-session <rid> <session>             exit 0 when the session exists
  list-sessions <rid>                     session names
  attach <rid> <session> <ro|rw>          tmux attach-session (ro = read-only)
  write-file <rid> <path> <mode>          write stdin to <path> as the runner user
  read-file <rid> <path>                  print <path> as the runner user (3 = absent)
  list-dir <rid> <path>                   NUL-separated entry names (empty when absent)
EOF
  exit 2
}

bad() { die "invalid $1" 2; }

check_rid() { [[ $1 =~ $RID_RE ]] || bad "runner id"; }
check_aid() { [[ $1 =~ $AID_RE ]] || bad "agent id"; }
check_session() { [[ $1 =~ $SESSION_RE ]] || bad "session name"; }
# A path acted on as the runner user: absolute, bounded, no control characters.
check_user_path() {
  [[ $1 == /* && ${#1} -le 4096 && ! $1 =~ [[:cntrl:]] ]] || bad "path"
}
# A project or worktree dir that root puts ACLs on: canonical, under a configured root.
check_workdir() {
  local p=$1 r
  [[ $p =~ ^(/[A-Za-z0-9_][A-Za-z0-9._-]*)+$ && ${#p} -le 1024 ]] || bad "workdir"
  for r in "$PROJECTS_ROOT" "$WORKTREES_ROOT"; do
    [[ $p == "$r"/* ]] && return 0
  done
  bad "workdir (not under $PROJECTS_ROOT or $WORKTREES_ROOT)"
}
check_argv() {
  [[ ${1-} == "--" ]] || usage
  shift
  [[ $# -ge 1 && -n $1 ]] || bad "argv"
}

load_conf() {
  [[ -f $CONF ]] || return 0
  local key value
  while IFS='=' read -r key value || [[ -n $key ]]; do
    case $key in '' | '#'*) continue ;; esac
    case $key in
      OFFICE_TMUX_DIR | OFFICE_PROJECTS_ROOT | OFFICE_WORKTREES_ROOT)
        [[ $value =~ $CONF_PATH_RE && ! $value =~ /\.\.?(/|$) ]] || die "bad $key in $CONF"
        ;;
      OFFICE_SERVER_USER) [[ $value =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "bad $key in $CONF" ;;
      *) die "unknown key $key in $CONF" ;;
    esac
    case $key in
      OFFICE_TMUX_DIR) TMUX_DIR=$value ;;
      OFFICE_PROJECTS_ROOT) PROJECTS_ROOT=$value ;;
      OFFICE_WORKTREES_ROOT) WORKTREES_ROOT=$value ;;
      OFFICE_SERVER_USER) SERVER_USER=$value ;;
    esac
  done <"$CONF"
}

# Sets U, R_UID, R_GID, R_HOME, SOCK for office-u-$RID; exit 3 if it does not exist.
load_user() {
  U="office-u-$RID"
  SOCK="$TMUX_DIR/$RID.sock"
  local ent gecos
  ent=$(getent passwd "$U") || die "no runner account $U" 3
  IFS=: read -r _ _ R_UID R_GID gecos R_HOME _ <<<"$ent"
  [[ $gecos == "$MARKER"* ]] || die "$U exists but is not an office runner account"
  [[ $R_UID =~ ^[0-9]+$ && $R_UID -ne 0 ]] || die "$U has an unexpected uid"
}

# The runner user's clean environment, as `env` arguments.
user_env_args() {
  USER_ENV=(env -i HOME="$R_HOME" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8
    PATH="$R_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin")
}
user_env() {
  user_env_args
  "${USER_ENV[@]}" "$@"
}

# Run a command as the runner user with a clean environment.
as_user() {
  user_env_args
  setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- "${USER_ENV[@]}" "$@"
}

sock_ok() { [[ -S $SOCK && ! -L $SOCK && $(stat -c %u -- "$SOCK") == "$R_UID" ]]; }
server_alive() { sock_ok && as_user tmux -S "$SOCK" show-options -gv exit-empty >/dev/null 2>&1; }
tmux_u() {
  sock_ok || die "tmux server of $U is not running" 3
  as_user tmux -S "$SOCK" "$@"
}

ensure_tmux_dir() {
  install -d -m 0755 -- "$(dirname -- "$TMUX_DIR")"
  # Sticky and not listable, like /tmp: runners create their own socket, can
  # neither list nor remove the others'. Socket ownership is checked on use.
  install -d -m 1733 -o root -g root -- "$TMUX_DIR"
}

ensure_server() {
  ensure_tmux_dir
  server_alive && return 0
  rm -f -- "$SOCK"
  systemctl stop "office-tmux-$RID.scope" >/dev/null 2>&1 || true
  (
    cd -- "$R_HOME"
    user_env env TERM=xterm-256color systemd-run --quiet --collect --scope --slice=system.slice \
      --unit="office-tmux-$RID" --description="Regulus Office tmux server of $U" \
      --uid="$R_UID" --gid="$R_GID" -- \
      tmux -S "$SOCK" -f /dev/null start-server \; set-option -g exit-empty off
  ) || die "could not start the tmux server of $U"
  server_alive || die "tmux server of $U did not come up"
}

# Reads the NUL-terminated env script from stdin into a fresh 0600 file owned by
# the runner (in ~/.office/env, 0700) and prints its path.
write_env_file() {
  local script f
  IFS= read -r -d '' script || die "stdin must start with a NUL-terminated env script" 2
  f=$(printf '%s' "$script" | as_user /bin/sh -c \
    'umask 077; d="$HOME/.office/env"; mkdir -p "$d" && f=$(mktemp "$d/env.XXXXXXXXXX") && cat >"$f" && printf %s "$f"') ||
    die "could not write the env file"
  [[ $f =~ ^"$R_HOME"/\.office/env/env\.[A-Za-z0-9]{10}$ ]] || die "unexpected env file path"
  printf '%s' "$f"
}

agent_units() {
  local d
  for d in "$CGROUP_DIR/agent-$AID.scope" "$CGROUP_DIR/agent-$AID".*.scope; do
    [[ -d $d ]] && printf '%s\n' "${d##*/}"
  done
  return 0
}

# PIDs of a unit that belong to the runner uid (a scope of another account is ignored).
unit_pids() {
  local pid
  local procs
  procs=$(cat "$CGROUP_DIR/$1/cgroup.procs" 2>/dev/null) || return 0
  while read -r pid; do
    [[ -n $pid && $(stat -c %u "/proc/$pid" 2>/dev/null) == "$R_UID" ]] && printf '%s\n' "$pid"
  done <<<"$procs"
  return 0
}

# True when every process of the unit belongs to the runner uid (or the unit is already gone).
unit_owned() {
  local pid procs
  procs=$(cat "$CGROUP_DIR/$1/cgroup.procs" 2>/dev/null) || return 0
  while read -r pid; do
    [[ -n $pid ]] || continue
    local owner
    owner=$(stat -c %u "/proc/$pid" 2>/dev/null) || continue
    [[ $owner == "$R_UID" ]] || return 1
  done <<<"$procs"
  return 0
}

cmd_provision() {
  U="office-u-$RID"
  if ! getent passwd "$U" >/dev/null; then
    local group=(--user-group)
    getent group "$U" >/dev/null && group=(--gid "$U")
    useradd --create-home --shell /bin/bash --comment "$MARKER" "${group[@]}" "$U"
  fi
  load_user
  chown -- "$R_UID:$R_GID" "$R_HOME"
  chmod 0700 -- "$R_HOME"
  ensure_server
  printf 'uid=%s\ngid=%s\nhome=%s\nsocket=%s\n' "$R_UID" "$R_GID" "$R_HOME" "$SOCK"
}

cmd_deprovision() {
  U="office-u-$RID"
  SOCK="$TMUX_DIR/$RID.sock"
  if ! getent passwd "$U" >/dev/null; then
    [[ -S $SOCK ]] && rm -f -- "$SOCK"
    return 0
  fi
  load_user
  systemctl stop "office-tmux-$RID.scope" >/dev/null 2>&1 || true
  for _ in $(seq 1 50); do
    pkill -KILL -U "$R_UID" 2>/dev/null || break
    sleep 0.1
  done
  rm -f -- "$SOCK"
  userdel --remove "$U" 2>/dev/null || [[ $? -eq 12 ]] || die "userdel $U failed"
  if getent group "$U" >/dev/null; then groupdel "$U"; fi
}

cmd_mount_project() {
  load_user
  local w=$WORKDIR root p rest seg
  [[ -d $w && ! -L $w ]] || die "workdir $w is not a directory" 3
  [[ $(realpath -e -- "$w") == "$w" ]] || die "workdir must be canonical, without symlinks"
  root=$PROJECTS_ROOT
  [[ $w == "$WORKTREES_ROOT"/* ]] && root=$WORKTREES_ROOT
  # Traverse-only on the root and every ancestor below it.
  p=$root
  rest=${w#"$root"/}
  setfacl -m "g:$U:--x" -- "$p"
  while [[ $rest == */* ]]; do
    seg=${rest%%/*}
    rest=${rest#*/}
    p="$p/$seg"
    [[ -d $p && ! -L $p ]] || die "ancestor $p is not a directory"
    setfacl -m "g:$U:--x" -- "$p"
  done
  # The human's group and the office server both get rw, now and for new files.
  # -P: never follow symlinks inside the checkout.
  setfacl -R -P -m "g:$U:rwX,d:g:$U:rwX,u:$SERVER_USER:rwX,d:u:$SERVER_USER:rwX" -- "$w"
  printf 'workdir=%s\n' "$w"
}

cmd_exec() {
  load_user
  ensure_server
  local session="agent-$AID" unit="agent-$AID.scope" envfile pid
  if as_user tmux -S "$SOCK" has-session -t "=$session" 2>/dev/null; then
    die "session $session already exists"
  fi
  [[ -d $CGROUP_DIR/$unit ]] && die "$unit is still running; kill the agent first"
  envfile=$(write_env_file)
  if ! as_user tmux -S "$SOCK" new-session -d -s "$session" -x 160 -y 45 -c "$CWD" -- \
    /bin/sh -c "$WRAPPER" office-agent "$unit" "$envfile" "$CWD" "${ARGV[@]}"; then
    rm -f -- "$envfile"
    die "tmux new-session failed"
  fi
  pid=$(as_user tmux -S "$SOCK" display-message -p -t "=$session:" '#{pane_pid}') || pid=
  if [[ ! $pid =~ ^[0-9]+$ ]] || ! busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
    org.freedesktop.systemd1.Manager StartTransientUnit 'ssa(sv)a(sa(sv))' "$unit" fail 4 \
    PIDs au 1 "$pid" Slice s system.slice CollectMode s inactive-or-failed \
    Description s "Regulus Office agent $AID of $U" 0 >/dev/null; then
    as_user tmux -S "$SOCK" kill-session -t "=$session" 2>/dev/null || true
    rm -f -- "$envfile"
    die "could not place the agent in $unit"
  fi
  for _ in $(seq 1 100); do
    grep -qs "/$unit\$" "/proc/$pid/cgroup" && break
    sleep 0.05
  done
  printf 'pid=%s\nunit=%s\n' "$pid" "$unit"
}

cmd_spawn_piped() {
  load_user
  local envfile nonce unit
  envfile=$(write_env_file)
  nonce=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  unit="agent-$AID.io-$nonce"
  cd -- "$R_HOME"
  user_env_args
  exec "${USER_ENV[@]}" systemd-run --quiet --collect --scope --slice=system.slice --unit="$unit" \
    --description="Regulus Office agent $AID of $U (piped)" --uid="$R_UID" --gid="$R_GID" -- \
    /bin/sh -c "$WRAPPER" office-agent "$unit.scope" "$envfile" "$CWD" "${ARGV[@]}"
}

cmd_kill() {
  U="office-u-$RID"
  getent passwd "$U" >/dev/null || return 0
  load_user
  if server_alive; then as_user tmux -S "$SOCK" kill-session -t "=agent-$AID" 2>/dev/null || true; fi
  local unit
  for unit in $(agent_units); do
    unit_owned "$unit" || die "$unit has processes of another account"
    systemctl kill --signal=SIGKILL -- "$unit" 2>/dev/null || true
  done
  for _ in $(seq 1 100); do
    [[ -z $(agent_units) ]] && break
    sleep 0.05
  done
  for unit in $(agent_units); do systemctl reset-failed -- "$unit" 2>/dev/null || true; done
  return 0
}

cmd_sockets() {
  load_user
  local unit pid dirs=()
  for unit in $(agent_units); do
    for pid in $(unit_pids "$unit"); do dirs+=("/proc/$pid/fd"); done
  done
  [[ ${#dirs[@]} -gt 0 ]] || return 0
  find "${dirs[@]}" -maxdepth 1 -lname 'socket:*' -printf '%h %l\n' 2>/dev/null |
    sed -n 's|^/proc/\([0-9]*\)/fd socket:\[\([0-9]*\)\]$|\1 \2|p' | sort -u || true
}

# Paste buffer $1 into the pane and delete it. `send-keys` is not used: tmux
# refuses it while a read-only client (a watcher) is attached. text = bracketed
# paste (-p); raw = control keys, -S so tmux >= 3.5 does not sanitize them
# (older tmux has no -S and pastes raw anyway).
paste_buffer() {
  local buf=$1 mode=$2 err
  if [[ $mode == text ]]; then
    err=$(tmux_u paste-buffer -d -p -b "$buf" -t "=$SESSION:" 2>&1) && return 0
  else
    err=$(tmux_u paste-buffer -d -S -b "$buf" -t "=$SESSION:" 2>&1) && return 0
    if [[ $err == *"unknown flag"* || $err == *"usage: paste-buffer"* ]]; then
      err=$(tmux_u paste-buffer -d -b "$buf" -t "=$SESSION:" 2>&1) && return 0
    fi
  fi
  tmux_u delete-buffer -b "$buf" 2>/dev/null || true
  die "paste-buffer failed: $err"
}

cmd_send_keys() {
  load_user
  local buf
  buf="office-keys-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
  tmux_u load-buffer -b "$buf" - || die "load-buffer failed"
  # Empty stdin leaves no buffer behind (Enter alone).
  if tmux_u show-buffer -b "$buf" >/dev/null 2>&1; then paste_buffer "$buf" "$PASTE"; fi
  if [[ $ENTER == 1 ]]; then
    printf '\r' | tmux_u load-buffer -b "$buf" - || die "load-buffer failed"
    paste_buffer "$buf" raw
  fi
}

cmd_attach() {
  load_user
  sock_ok || die "tmux server of $U is not running" 3
  local term=${TERM:-xterm-256color} ro=()
  [[ $term =~ ^[A-Za-z0-9._+-]{1,64}$ ]] || term=xterm-256color
  [[ $MODE == ro ]] && ro=(-r)
  user_env_args
  exec setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- \
    "${USER_ENV[@]}" TERM="$term" tmux -S "$SOCK" attach-session "${ro[@]}" -t "=$SESSION"
}

cmd_write_file() {
  load_user
  as_user /bin/sh -c 'umask 077; d=$(dirname -- "$1"); mkdir -p -- "$d" &&
    t=$(mktemp "$d/.office-write.XXXXXXXX") && cat >"$t" && chmod "$2" -- "$t" && mv -f -- "$t" "$1" ||
    { rm -f -- "$t"; exit 1; }' office-write "$FPATH" "$FMODE" || die "write-file failed"
}

main() {
  [[ $# -ge 1 ]] || usage
  local verb=$1
  shift
  load_conf
  # 1. Validate every argument (no side effects before this).
  case $verb in
    provision | deprovision | list-sessions)
      [[ $# -eq 1 ]] || usage
      check_rid "$1"
      ;;
    mount-project)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_workdir "$2"
      WORKDIR=$2
      ;;
    exec | spawn-piped)
      [[ $# -ge 5 ]] || usage
      check_rid "$1"
      check_aid "$2"
      check_user_path "$3"
      check_argv "${@:4}"
      AID=$2 CWD=$3
      ARGV=("${@:5}")
      ;;
    kill | sockets)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_aid "$2"
      AID=$2
      ;;
    capture)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 =~ ^[0-9]{1,6}$ ]] || bad "line count"
      SESSION=$2 LINES_=$3
      ;;
    pane-title | has-session)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_session "$2"
      SESSION=$2
      ;;
    send-keys)
      [[ $# -eq 4 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 == 0 || $3 == 1 ]] || bad "enter flag"
      [[ $4 == text || $4 == raw ]] || bad "paste mode"
      SESSION=$2 ENTER=$3 PASTE=$4
      ;;
    attach)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 == ro || $3 == rw ]] || bad "attach mode"
      SESSION=$2 MODE=$3
      ;;
    write-file)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_user_path "$2"
      [[ $3 =~ ^0?[0-7]{3}$ ]] || bad "mode"
      FPATH=$2 FMODE=$3
      ;;
    read-file | list-dir)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_user_path "$2"
      FPATH=$2
      ;;
    *) usage ;;
  esac
  RID=$1
  # 2. Only then require root.
  [[ $EUID -eq 0 ]] || die "must run as root (sudo -n office-runner-helper ...)"
  case $verb in
    provision) cmd_provision ;;
    deprovision) cmd_deprovision ;;
    mount-project) cmd_mount_project ;;
    exec) cmd_exec ;;
    spawn-piped) cmd_spawn_piped ;;
    kill) cmd_kill ;;
    sockets) cmd_sockets ;;
    capture) load_user && tmux_u capture-pane -p -J -t "=$SESSION:" -S "-$LINES_" ;;
    pane-title) load_user && tmux_u display-message -p -t "=$SESSION:" '#{pane_title}' ;;
    has-session) load_user && server_alive && as_user tmux -S "$SOCK" has-session -t "=$SESSION" 2>/dev/null ;;
    list-sessions) load_user && { ! server_alive || as_user tmux -S "$SOCK" list-sessions -F '#{session_name}'; } ;;
    send-keys) cmd_send_keys ;;
    attach) cmd_attach ;;
    write-file) cmd_write_file ;;
    read-file) load_user && as_user /bin/sh -c '[ -f "$1" ] || exit 3; exec cat -- "$1"' office-read "$FPATH" ;;
    list-dir) load_user && as_user /bin/sh -c '[ -d "$1" ] || exit 0; exec find "$1" -mindepth 1 -maxdepth 1 -printf "%f\0"' office-ls "$FPATH" ;;
  esac
}

main "$@"
