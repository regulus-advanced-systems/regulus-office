#!/bin/bash
# office-runner-helper: the only privileged entry point of the linux-user runner
# backend (SPEC §8, docs/deploy/linux-user-runner.md). office-server runs it as
# `sudo -n office-runner-helper <verb> <args>`; it is installed root:root 0755
# at /usr/local/lib/office/office-runner-helper.
#
# Trust model: office-server may act as any office runner account
# (`office-u-<rid>`), which is what running agents for humans means. It must not
# be able to become root or any other account. Hence every argument is checked
# against a strict grammar before anything runs, root-level work is limited to
# account/tmux/cgroup/ACL plumbing, and everything else runs as the runner user
# (setpriv). Nothing here echoes stdin: it carries env and file contents that
# may hold secrets.
#
# Exit codes: 0 ok, 1 failure, 2 invalid arguments, 3 not found.
# Single-quoted scripts below are run by /bin/sh as the runner user, on purpose.
# shellcheck disable=SC2016
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly CONF=/etc/office/runner-helper.conf
readonly CGROUP_DIR=/sys/fs/cgroup/system.slice
readonly MARKER="Regulus Office runner"
readonly RID_RE='^[a-z0-9]{1,23}$'
readonly AID_RE='^[A-Za-z0-9_-]{1,64}$'
readonly SESSION_RE='^agent-[A-Za-z0-9_-]{1,64}$'
readonly CONF_PATH_RE='^(/[A-Za-z0-9._-]+)+$'
# Floor slugs (apps/server/src/floors/naming.ts): no dots, slashes or leading/trailing dash.
readonly SLUG_RE='^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$'
TMUX_DIR=/run/office/tmux
PROJECTS_ROOT=/srv/office/projects
WORKTREES_ROOT=/srv/office/worktrees
SERVER_USER=office
# Per-agent sandboxes (#169): records, the bridge's /16, the office port forwarded into them.
readonly SANDBOX_DIR=/run/office/sandboxes
readonly BRIDGE=office-sbx0
readonly OWNER_RE='^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$'
SANDBOX_NET=10.231
OFFICE_PORT=4600

# Runs inside the agent's tmux pane or piped scope, as the runner user. Waits
# until the process sits in its own scope (exec adopts the pane pid after tmux
# forked it), then sources and deletes the 0600 env file and execs the agent.
readonly WRAPPER='unit=$1 envfile=$2 cwd=$3
shift 3
in_unit() {
  while IFS= read -r l; do case $l in "0::"*"/$unit") return 0 ;; esac; done </proc/self/cgroup
  return 1
}
i=0
until in_unit; do
  i=$((i + 1))
  if [ "$i" -gt 200 ]; then echo "office: $unit not ready" >&2; rm -f "$envfile"; exit 1; fi
  sleep 0.05
done
. "$envfile"
rm -f "$envfile"
cd "$cwd" || exit 1
exec "$@"'

die() {
  echo "office-runner-helper: $1" >&2
  exit "${2:-1}"
}

usage() {
  cat >&2 <<'EOF'
usage: office-runner-helper <verb> <args>
  provision <rid>                         create office-u-<rid>, HOME 0700, tmux server
  deprovision <rid>                       kill everything of office-u-<rid>, delete it
  mount-project <rid> <workdir>           ACL a dir inside <worktrees>/<floor>/<rid> for office-u-<rid>
  reclaim <dir>                           give a pre-#114 shared dir back to the office only
  remove-floor <slug>                     delete <projects>/<slug> and <worktrees>/<slug> (floor deleted)
  exec <rid> <agentId> <cwd> -- <argv..>  tmux session agent-<agentId> in scope agent-<agentId>
                                          (stdin: env script, NUL-terminated); in the agent's
                                          sandbox when it has one
  spawn-piped <rid> <agentId> <cwd> -- <argv..>
                                          piped process in scope agent-<agentId>.io-<n>
                                          (stdin: env script, NUL, then the process stdin)
  kill <rid> <agentId>                    kill the session and every agent-<agentId> scope,
                                          remove the agent's sandbox
  sandbox-up <rid> <agentId> <slot> <memory bytes> <cpu %> <tasks> <owner>
                                          the agent's sandbox: network namespace on the
                                          sandbox bridge, limits for its scopes
  sandbox-list                            "<agentId> <rid> <slot> <address> <owner>" per sandbox
  sockets <rid> <agentId>                 "<pid> <inode>" for sockets of the agent's processes
  capture <rid> <session> <lines>         tmux capture-pane
  pane-title <rid> <session>              tmux pane title
  send-keys <rid> <session> <0|1> <text|raw>
                                          paste stdin into the pane (text = bracketed,
                                          raw = control keys), 1 = press Enter after
  has-session <rid> <session>             exit 0 when the session exists
  list-sessions <rid>                     session names
  attach <rid> <session> <ro|rw>          tmux attach-session (ro = read-only)
  write-file <rid> <path> <mode>          write stdin to <path> as the runner user
  read-file <rid> <path>                  print <path> as the runner user (3 = absent)
  list-dir <rid> <path>                   NUL-separated entry names (empty when absent)
EOF
  exit 2
}

bad() { die "invalid $1" 2; }

check_rid() { [[ $1 =~ $RID_RE ]] || bad "runner id"; }
check_aid() { [[ $1 =~ $AID_RE ]] || bad "agent id"; }
check_session() { [[ $1 =~ $SESSION_RE ]] || bad "session name"; }
# A path acted on as the runner user: absolute, bounded, no control characters.
check_user_path() {
  [[ $1 == /* && ${#1} -le 4096 && ! $1 =~ [[:cntrl:]] ]] || bad "path"
}
# Canonical path syntax for dirs root acts on: no symlink tricks, no dot segments.
check_canonical() {
  [[ $1 =~ ^(/[A-Za-z0-9_][A-Za-z0-9._-]*)+$ && ${#1} -le 1024 ]] || bad "$2"
}
# A dir root puts ACLs on for office-u-$1: inside that human's own area on a floor,
# <worktrees>/<floor>/<rid> (#114). Mirrors, floor dirs and other humans' areas never qualify.
check_workdir() {
  local rid=$1 p=$2 rest
  check_canonical "$p" "workdir"
  [[ $p == "$WORKTREES_ROOT"/* ]] || bad "workdir (not under $WORKTREES_ROOT)"
  rest=${p#"$WORKTREES_ROOT"/}
  [[ $rest == */* ]] || bad "workdir (not a runner's own dir)"
  rest=${rest#*/}
  [[ ${rest%%/*} == "$rid" ]] || bad "workdir (not inside office-u-$rid's own dir)"
}
# A dir shared with runners before #114: the projects root or anything in it (mirrors),
# or a per-agent worktree directly in a floor dir, <worktrees>/<floor>/<agent>.
check_reclaim_dir() {
  local p=$1 rest
  check_canonical "$p" "dir"
  [[ $p == "$PROJECTS_ROOT" || $p == "$PROJECTS_ROOT"/* ]] && return 0
  [[ $p == "$WORKTREES_ROOT"/* ]] || bad "dir (not under $PROJECTS_ROOT or $WORKTREES_ROOT)"
  rest=${p#"$WORKTREES_ROOT"/}
  [[ $rest == */* && ${rest#*/} != */* ]] || bad "dir (not <worktrees>/<floor>/<agent>)"
  # Agent ids are UUIDs; a runner id there is a human's own area, never reclaimed.
  [[ ! ${rest#*/} =~ $RID_RE ]] || bad "dir (a runner's own area)"
}
check_argv() {
  [[ ${1-} == "--" ]] || usage
  shift
  [[ $# -ge 1 && -n $1 ]] || bad "argv"
}

load_conf() {
  [[ -f $CONF ]] || return 0
  local key value
  while IFS='=' read -r key value || [[ -n $key ]]; do
    case $key in '' | '#'*) continue ;; esac
    case $key in
      OFFICE_TMUX_DIR | OFFICE_PROJECTS_ROOT | OFFICE_WORKTREES_ROOT)
        [[ $value =~ $CONF_PATH_RE && ! $value =~ /\.\.?(/|$) ]] || die "bad $key in $CONF"
        ;;
      OFFICE_SERVER_USER) [[ $value =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "bad $key in $CONF" ;;
      OFFICE_SANDBOX_NET)
        [[ $value =~ ^(10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])|192\.168)$ ]] || die "bad $key in $CONF"
        [[ ${value#*.} -le 255 ]] || die "bad $key in $CONF"
        ;;
      OFFICE_PORT) [[ $value =~ ^[1-9][0-9]{0,4}$ && $value -le 65535 ]] || die "bad $key in $CONF" ;;
      *) die "unknown key $key in $CONF" ;;
    esac
    case $key in
      OFFICE_TMUX_DIR) TMUX_DIR=$value ;;
      OFFICE_PROJECTS_ROOT) PROJECTS_ROOT=$value ;;
      OFFICE_WORKTREES_ROOT) WORKTREES_ROOT=$value ;;
      OFFICE_SERVER_USER) SERVER_USER=$value ;;
      OFFICE_SANDBOX_NET) SANDBOX_NET=$value ;;
      OFFICE_PORT) OFFICE_PORT=$value ;;
    esac
  done <"$CONF"
}

# Sets U, R_UID, R_GID, R_HOME, SOCK for office-u-$RID; exit 3 if it does not exist.
load_user() {
  U="office-u-$RID"
  SOCK="$TMUX_DIR/$RID.sock"
  local ent gecos
  ent=$(getent passwd "$U") || die "no runner account $U" 3
  IFS=: read -r _ _ R_UID R_GID gecos R_HOME _ <<<"$ent"
  [[ $gecos == "$MARKER"* ]] || die "$U exists but is not an office runner account"
  [[ $R_UID =~ ^[0-9]+$ && $R_UID -ne 0 ]] || die "$U has an unexpected uid"
}

# The runner user's clean environment, as `env` arguments.
user_env_args() {
  USER_ENV=(env -i HOME="$R_HOME" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8
    PATH="$R_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin")
}
user_env() {
  user_env_args
  "${USER_ENV[@]}" "$@"
}

# Run a command as the runner user with a clean environment.
as_user() {
  user_env_args
  setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- "${USER_ENV[@]}" "$@"
}

sock_ok() { [[ -S $SOCK && ! -L $SOCK && $(stat -c %u -- "$SOCK") == "$R_UID" ]]; }
server_alive() { sock_ok && as_user tmux -S "$SOCK" show-options -gv exit-empty >/dev/null 2>&1; }
tmux_u() {
  sock_ok || die "tmux server of $U is not running" 3
  as_user tmux -S "$SOCK" "$@"
}

ensure_tmux_dir() {
  install -d -m 0755 -- "$(dirname -- "$TMUX_DIR")"
  # Sticky and not listable, like /tmp: runners create their own socket, can
  # neither list nor remove the others'. Socket ownership is checked on use.
  install -d -m 1733 -o root -g root -- "$TMUX_DIR"
}

ensure_server() {
  ensure_tmux_dir
  server_alive && return 0
  rm -f -- "$SOCK"
  systemctl stop "office-tmux-$RID.scope" >/dev/null 2>&1 || true
  (
    cd -- "$R_HOME"
    user_env env TERM=xterm-256color systemd-run --quiet --collect --scope --slice=system.slice \
      --unit="office-tmux-$RID" --description="Regulus Office tmux server of $U" \
      --uid="$R_UID" --gid="$R_GID" -- \
      tmux -S "$SOCK" -f /dev/null start-server \; set-option -g exit-empty off
  ) || die "could not start the tmux server of $U"
  server_alive || die "tmux server of $U did not come up"
}

# Reads the NUL-terminated env script from stdin into a fresh 0600 file owned by
# the runner (in ~/.office/env, 0700) and prints its path.
write_env_file() {
  local script f
  IFS= read -r -d '' script || die "stdin must start with a NUL-terminated env script" 2
  f=$(printf '%s' "$script" | as_user /bin/sh -c \
    'umask 077; d="$HOME/.office/env"; mkdir -p "$d" && f=$(mktemp "$d/env.XXXXXXXXXX") && cat >"$f" && printf %s "$f"') ||
    die "could not write the env file"
  [[ $f =~ ^"$R_HOME"/\.office/env/env\.[A-Za-z0-9]{10}$ ]] || die "unexpected env file path"
  printf '%s' "$f"
}

agent_units() {
  local d
  for d in "$CGROUP_DIR/agent-$AID.scope" "$CGROUP_DIR/agent-$AID".*.scope; do
    [[ -d $d ]] && printf '%s\n' "${d##*/}"
  done
  return 0
}

# PIDs of a unit that belong to the runner uid (a scope of another account is ignored).
unit_pids() {
  local pid
  local procs
  procs=$(cat "$CGROUP_DIR/$1/cgroup.procs" 2>/dev/null) || return 0
  while read -r pid; do
    [[ -n $pid && $(stat -c %u "/proc/$pid" 2>/dev/null) == "$R_UID" ]] && printf '%s\n' "$pid"
  done <<<"$procs"
  return 0
}

# True when every process of the unit belongs to the runner uid (or the unit is already gone).
# A sandbox's scope (#169) also holds the root `unshare` that is the parent of its pid namespace.
unit_owned() {
  local pid procs unshare
  unshare=$(readlink -f -- "$(command -v unshare)")
  procs=$(cat "$CGROUP_DIR/$1/cgroup.procs" 2>/dev/null) || return 0
  while read -r pid; do
    [[ -n $pid ]] || continue
    local owner
    owner=$(stat -c %u "/proc/$pid" 2>/dev/null) || continue
    [[ $owner == "$R_UID" ]] && continue
    [[ $owner == 0 && $(readlink -- "/proc/$pid/exe" 2>/dev/null) == "$unshare" ]] || return 1
  done <<<"$procs"
  return 0
}

# ---- Per-agent sandboxes (SPEC §8, D18, #169) --------------------------------
# A robot's sandbox is a root-only record $SANDBOX_DIR/<agentId> (its runner,
# slot, limits and office owner), a network namespace office-sbx<slot> whose
# eth0 is a veth on the bridge $BRIDGE, and, while the robot runs, its own tmux
# server: pid 1 of a fresh pid namespace (with its own /proc) inside that
# network namespace, in scope agent-<agentId>.scope with the record's limits.
# Slot n has the address $SANDBOX_NET.<(n+2)/256>.<(n+2)%256>/16; the bridge is
# $SANDBOX_NET.0.1. Bridge ports are isolated from each other; the host routes
# and masquerades the sandboxes' traffic, and forwards 127.0.0.1:$OFFICE_PORT
# (the office, for hooks) and a loopback DNS stub into every sandbox.

sandbox_addr() {
  local n=$(($1 + 2))
  printf '%s.%s.%s' "$SANDBOX_NET" $((n / 256)) $((n % 256))
}

# Sets S_RID S_SLOT S_MEM S_CPU S_TASKS S_OWNER from agent $1's record; 1 if it has none.
load_sandbox() {
  local f="$SANDBOX_DIR/$1" key value
  [[ -f $f && ! -L $f ]] || return 1
  S_RID='' S_SLOT='' S_MEM='' S_CPU='' S_TASKS='' S_OWNER=''
  while IFS='=' read -r key value; do
    case $key in
      rid) S_RID=$value ;;
      slot) S_SLOT=$value ;;
      mem) S_MEM=$value ;;
      cpu) S_CPU=$value ;;
      tasks) S_TASKS=$value ;;
      owner) S_OWNER=$value ;;
    esac
  done <"$f"
  [[ $S_RID =~ $RID_RE && $S_SLOT =~ ^[0-9]{1,5}$ && $S_MEM =~ ^[0-9]{1,15}$ &&
    $S_CPU =~ ^[0-9]{1,5}$ && $S_TASKS =~ ^[0-9]{1,7}$ && $S_OWNER =~ $OWNER_RE ]] ||
    die "corrupt sandbox record $f"
  LIMITS=(-p "MemoryMax=$S_MEM" -p MemorySwapMax=0 -p "CPUQuota=$S_CPU%" -p "TasksMax=$S_TASKS")
}

# Agent $AID's sandbox of runner $RID (sets S_*); 1 if it has none, dies if another runner's.
own_sandbox() {
  load_sandbox "$AID" || return 1
  [[ $S_RID == "$RID" ]] || die "agent $AID has a sandbox of another runner"
}

sandbox_sock() { printf '%s/%s.sbx%s.sock' "$TMUX_DIR" "$RID" "$S_SLOT"; }

# Session verbs: a session of a sandboxed agent lives on the sandbox's own tmux server.
use_session_sock() {
  AID=${SESSION#agent-}
  if own_sandbox; then SOCK=$(sandbox_sock); fi
  return 0
}

# Every sandbox record: prints agent ids.
sandbox_ids() {
  local rec
  [[ -d $SANDBOX_DIR ]] || return 0
  for rec in "$SANDBOX_DIR"/*; do
    [[ -f $rec && ${rec##*/} =~ $AID_RE ]] && printf '%s\n' "${rec##*/}"
  done
  return 0
}

sandbox_lock() {
  install -d -m 0700 -o root -g root -- "$SANDBOX_DIR"
  exec 9>"$SANDBOX_DIR/.lock"
  flock 9
}

# The loopback resolver of the host (e.g. systemd-resolved's 127.0.0.53), if any.
loopback_dns() {
  sed -n 's/^nameserver[[:space:]]\{1,\}\(127\.[0-9.]*\)[[:space:]]*$/\1/p' /etc/resolv.conf 2>/dev/null |
    head -n 1
}

# The bridge, forwarding and NAT on the host (idempotent; the nft table is replaced whole).
net_host_up() {
  local gw="$SANDBOX_NET.0.1" dns rules=""
  if ! ip link show dev "$BRIDGE" >/dev/null 2>&1; then
    ip link add "$BRIDGE" type bridge
    ip addr add "$gw/16" dev "$BRIDGE"
  fi
  ip link set "$BRIDGE" up
  sysctl -qw net.ipv4.ip_forward=1
  # The office and the DNS stub listen on loopback; DNAT to 127/8 needs this on the bridge.
  sysctl -qw "net.ipv4.conf.$BRIDGE.route_localnet=1"
  dns=$(loopback_dns)
  [[ -n $dns ]] && rules="iifname \"$BRIDGE\" ip daddr $gw meta l4proto { tcp, udp } th dport 53 dnat to $dns:53"
  nft -f - <<NFT || die "could not set up the sandbox NAT (nft)"
table ip office_sandbox
delete table ip office_sandbox
table ip office_sandbox {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "$BRIDGE" ip daddr $gw tcp dport $OFFICE_PORT dnat to 127.0.0.1:$OFFICE_PORT
    $rules
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $SANDBOX_NET.0.0/16 oifname != "$BRIDGE" masquerade
  }
}
NFT
  # Docker sets the FORWARD policy to DROP; its DOCKER-USER chain is where hosts allow more.
  if command -v iptables >/dev/null && iptables -S DOCKER-USER >/dev/null 2>&1; then
    iptables -C DOCKER-USER -i "$BRIDGE" -j ACCEPT 2>/dev/null ||
      iptables -I DOCKER-USER -i "$BRIDGE" -j ACCEPT
    iptables -C DOCKER-USER -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT \
      2>/dev/null ||
      iptables -I DOCKER-USER -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  fi
}

# Network namespace office-sbx<slot> for the sandbox in S_* (replaces a stale one).
net_sandbox_up() {
  local ns="office-sbx$S_SLOT" veth="osb$S_SLOT" gw="$SANDBOX_NET.0.1" addr dns rules=""
  addr=$(sandbox_addr "$S_SLOT")
  ip netns del "$ns" 2>/dev/null || true
  ip link del "$veth" 2>/dev/null || true
  ip netns add "$ns"
  ip link add "$veth" type veth peer name eth0 netns "$ns"
  ip link set "$veth" master "$BRIDGE"
  # Isolated bridge ports cannot reach each other, only the host.
  bridge link set dev "$veth" isolated on
  ip link set "$veth" up
  ip -n "$ns" link set lo up
  ip -n "$ns" addr add "$addr/16" dev eth0
  ip -n "$ns" link set eth0 up
  ip -n "$ns" route add default via "$gw"
  # 127.0.0.1:$OFFICE_PORT and the loopback DNS stub inside go to the host.
  nsenter --net="/run/netns/$ns" sysctl -qw net.ipv4.conf.all.route_localnet=1
  dns=$(loopback_dns)
  [[ -n $dns ]] && rules="ip daddr $dns meta l4proto { tcp, udp } th dport 53 dnat to $gw:53"
  nsenter --net="/run/netns/$ns" nft -f - <<NFT || die "could not set up the sandbox NAT (nft)"
table ip office_sandbox {
  chain output {
    type nat hook output priority dstnat; policy accept;
    ip daddr 127.0.0.1 tcp dport $OFFICE_PORT dnat to $gw:$OFFICE_PORT
    $rules
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 127.0.0.0/8 oifname "eth0" masquerade
  }
}
NFT
}

# Remove the sandbox in S_* of agent $AID (its scopes are already gone). Holds the lock.
sandbox_down() {
  rm -f -- "$(sandbox_sock)"
  ip netns del "office-sbx$S_SLOT" 2>/dev/null || true
  ip link del "osb$S_SLOT" 2>/dev/null || true
  rm -f -- "${SANDBOX_DIR:?}/$AID"
}

cmd_sandbox_up() {
  load_user
  sandbox_lock
  local id
  if load_sandbox "$AID"; then
    [[ $S_RID == "$RID" ]] || die "agent $AID has a sandbox of another runner"
    [[ $S_SLOT == "$SLOT" ]] || die "agent $AID already has sandbox slot $S_SLOT"
  else
    for id in $(sandbox_ids); do
      load_sandbox "$id" && [[ $S_SLOT == "$SLOT" ]] && die "sandbox slot $SLOT is taken" 3
    done
  fi
  printf 'rid=%s\nslot=%s\nmem=%s\ncpu=%s\ntasks=%s\nowner=%s\n' \
    "$RID" "$SLOT" "$MEM" "$CPU" "$TASKS" "$OWNER" >"$SANDBOX_DIR/.new"
  mv -f -- "$SANDBOX_DIR/.new" "$SANDBOX_DIR/$AID"
  load_sandbox "$AID"
  net_host_up
  if [[ ! -e /run/netns/office-sbx$SLOT ]] || ! ip link show dev "osb$SLOT" >/dev/null 2>&1; then
    net_sandbox_up
  fi
  printf 'address=%s\nslot=%s\n' "$(sandbox_addr "$SLOT")" "$SLOT"
}

cmd_sandbox_list() {
  local id
  for id in $(sandbox_ids); do
    load_sandbox "$id" || continue
    printf '%s %s %s %s %s\n' "$id" "$S_RID" "$S_SLOT" "$(sandbox_addr "$S_SLOT")" "$S_OWNER"
  done
}

# exec into the sandbox in S_*: its tmux server starts with the session and ends with it.
exec_in_sandbox() {
  local session="agent-$AID" unit="agent-$AID" ns="office-sbx$S_SLOT" envfile
  SOCK=$(sandbox_sock)
  [[ -e /run/netns/$ns ]] || die "the sandbox of agent $AID has no network namespace; set it up again"
  [[ -d $CGROUP_DIR/$unit.scope ]] && die "$unit.scope is still running; kill the agent first"
  envfile=$(write_env_file)
  rm -f -- "$SOCK"
  (
    cd -- "$R_HOME"
    user_env_args
    exec </dev/null >/dev/null 2>&1
    exec systemd-run --quiet --collect --scope --slice=system.slice --unit="$unit" \
      --description="Regulus Office sandbox of agent $AID of $U" "${LIMITS[@]}" -- \
      nsenter --net="/run/netns/$ns" -- \
      unshare --pid --fork --kill-child --mount-proc -- \
      setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- \
      "${USER_ENV[@]}" TERM=xterm-256color tmux -D -S "$SOCK" -f /dev/null
  ) &
  for _ in $(seq 1 100); do
    sock_ok && break
    sleep 0.05
  done
  if ! sock_ok || ! as_user tmux -S "$SOCK" new-session -d -s "$session" -x 160 -y 45 -c "$CWD" -- \
    /bin/sh -c "$WRAPPER" office-agent "$unit.scope" "$envfile" "$CWD" "${ARGV[@]}"; then
    systemctl kill --signal=SIGKILL -- "$unit.scope" 2>/dev/null || true
    rm -f -- "$envfile" "$SOCK"
    die "could not start the sandbox of agent $AID"
  fi
  # From now on the server, and with it the scope, ends with the robot's session.
  as_user tmux -S "$SOCK" set-option -g exit-empty on >/dev/null 2>&1 || true
  printf 'unit=%s\nsandbox=%s\n' "$unit.scope" "$(sandbox_addr "$S_SLOT")"
}

cmd_provision() {
  U="office-u-$RID"
  if ! getent passwd "$U" >/dev/null; then
    local group=(--user-group)
    getent group "$U" >/dev/null && group=(--gid "$U")
    useradd --create-home --shell /bin/bash --comment "$MARKER" "${group[@]}" "$U"
  fi
  load_user
  chown -- "$R_UID:$R_GID" "$R_HOME"
  chmod 0700 -- "$R_HOME"
  ensure_server
  printf 'uid=%s\ngid=%s\nhome=%s\nsocket=%s\n' "$R_UID" "$R_GID" "$R_HOME" "$SOCK"
}

cmd_deprovision() {
  U="office-u-$RID"
  SOCK="$TMUX_DIR/$RID.sock"
  if ! getent passwd "$U" >/dev/null; then
    [[ -S $SOCK ]] && rm -f -- "$SOCK"
    return 0
  fi
  load_user
  systemctl stop "office-tmux-$RID.scope" >/dev/null 2>&1 || true
  for _ in $(seq 1 50); do
    pkill -KILL -U "$R_UID" 2>/dev/null || break
    sleep 0.1
  done
  rm -f -- "$SOCK"
  local id
  sandbox_lock
  for id in $(sandbox_ids); do
    load_sandbox "$id" && [[ $S_RID == "$RID" ]] && AID=$id && sandbox_down
  done
  userdel --remove "$U" 2>/dev/null || [[ $? -eq 12 ]] || die "userdel $U failed"
  if getent group "$U" >/dev/null; then groupdel "$U"; fi
}

cmd_mount_project() {
  load_user
  local w=$WORKDIR root=$WORKTREES_ROOT area p rest seg
  rest=${w#"$root"/}
  area="$root/${rest%%/*}/$RID"
  [[ -d $w && ! -L $w ]] || die "workdir $w is not a directory" 3
  [[ $(realpath -e -- "$w") == "$w" ]] || die "workdir must be canonical, without symlinks"
  [[ -d $area && ! -L $area ]] || die "$area is not a directory"
  # Other humans get traverse on the floor dir, so the area itself must not
  # be open to "other": only the office (owner) and this human's ACL get in.
  chmod o-rwx -- "$area"
  # Traverse-only on the root and every ancestor below it.
  p=$root
  rest=${w#"$root"/}
  setfacl -m "g:$U:--x" -- "$p"
  while [[ $rest == */* ]]; do
    seg=${rest%%/*}
    rest=${rest#*/}
    p="$p/$seg"
    [[ -d $p && ! -L $p ]] || die "ancestor $p is not a directory"
    setfacl -m "g:$U:--x" -- "$p"
  done
  # The human's group and the office server both get rw, now and for new files.
  # -P: never follow symlinks inside the checkout.
  setfacl -R -P -m "g:$U:rwX,d:g:$U:rwX,u:$SERVER_USER:rwX,d:u:$SERVER_USER:rwX" -- "$w"
  printf 'workdir=%s\n' "$w"
}

# Before #114 floor mirrors and per-agent worktrees carried runner ACLs and
# files owned by runner accounts. Hand them back to the office alone: owner
# and group become the server user's, every extended ACL entry goes, and
# "other" loses access to the top dir. -P/-h: never follow symlinks.
cmd_reclaim() {
  local d=$RDIR
  [[ -d $d && ! -L $d ]] || die "$d is not a directory" 3
  [[ $(realpath -e -- "$d") == "$d" ]] || die "dir must be canonical, without symlinks"
  getent passwd "$SERVER_USER" >/dev/null || die "no server user $SERVER_USER"
  chown -R -P -h -- "$SERVER_USER": "$d"
  setfacl -R -P -b -- "$d"
  chmod o-rwx -- "$d"
  printf 'reclaimed=%s\n' "$d"
}

# A deleted floor (#150): its mirror dir <projects>/<slug> and its floor dir
# <worktrees>/<slug> (every human's area: clones and agent worktrees, files
# owned by runner accounts). The slug grammar keeps the target exactly one
# level below a configured root; the roots must be canonical; the target must
# be a real directory. GNU rm -r walks with openat/O_NOFOLLOW, so it never
# follows a symlink, even one swapped in while it runs, and
# --one-file-system keeps it off other mounts.
cmd_remove_floor() {
  local root d
  for root in "$PROJECTS_ROOT" "$WORKTREES_ROOT"; do
    [[ -d $root && ! -L $root ]] || continue
    [[ $(realpath -e -- "$root") == "$root" ]] || die "$root must be canonical, without symlinks"
    d="$root/$SLUG"
    [[ -e $d || -L $d ]] || continue
    [[ -d $d && ! -L $d ]] || die "$d is not a directory"
    [[ $(realpath -e -- "$d") == "$d" ]] || die "$d must be canonical, without symlinks"
    rm -r -f --one-file-system -- "$d" || die "could not remove $d"
    printf 'removed=%s\n' "$d"
  done
}

cmd_exec() {
  load_user
  if own_sandbox; then
    exec_in_sandbox
    return
  fi
  ensure_server
  local session="agent-$AID" unit="agent-$AID.scope" envfile pid
  if as_user tmux -S "$SOCK" has-session -t "=$session" 2>/dev/null; then
    die "session $session already exists"
  fi
  [[ -d $CGROUP_DIR/$unit ]] && die "$unit is still running; kill the agent first"
  envfile=$(write_env_file)
  if ! as_user tmux -S "$SOCK" new-session -d -s "$session" -x 160 -y 45 -c "$CWD" -- \
    /bin/sh -c "$WRAPPER" office-agent "$unit" "$envfile" "$CWD" "${ARGV[@]}"; then
    rm -f -- "$envfile"
    die "tmux new-session failed"
  fi
  pid=$(as_user tmux -S "$SOCK" display-message -p -t "=$session:" '#{pane_pid}') || pid=
  if [[ ! $pid =~ ^[0-9]+$ ]] || ! busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
    org.freedesktop.systemd1.Manager StartTransientUnit 'ssa(sv)a(sa(sv))' "$unit" fail 4 \
    PIDs au 1 "$pid" Slice s system.slice CollectMode s inactive-or-failed \
    Description s "Regulus Office agent $AID of $U" 0 >/dev/null; then
    as_user tmux -S "$SOCK" kill-session -t "=$session" 2>/dev/null || true
    rm -f -- "$envfile"
    die "could not place the agent in $unit"
  fi
  for _ in $(seq 1 100); do
    grep -qs "/$unit\$" "/proc/$pid/cgroup" && break
    sleep 0.05
  done
  printf 'pid=%s\nunit=%s\n' "$pid" "$unit"
}

cmd_spawn_piped() {
  load_user
  local envfile nonce unit sandboxed=0
  if own_sandbox; then
    sandboxed=1
    [[ -e /run/netns/office-sbx$S_SLOT ]] || die "the sandbox of agent $AID has no network namespace"
  fi
  envfile=$(write_env_file)
  nonce=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  unit="agent-$AID.io-$nonce"
  cd -- "$R_HOME"
  user_env_args
  if ((sandboxed)); then
    # In the robot's sandbox (#169): its network namespace and limits, a pid namespace of its own.
    exec systemd-run --quiet --collect --scope --slice=system.slice --unit="$unit" \
      --description="Regulus Office agent $AID of $U (piped, sandboxed)" "${LIMITS[@]}" -- \
      nsenter --net="/run/netns/office-sbx$S_SLOT" -- \
      unshare --pid --fork --kill-child --mount-proc -- \
      setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- \
      "${USER_ENV[@]}" /bin/sh -c "$WRAPPER" office-agent "$unit.scope" "$envfile" "$CWD" "${ARGV[@]}"
  fi
  exec "${USER_ENV[@]}" systemd-run --quiet --collect --scope --slice=system.slice --unit="$unit" \
    --description="Regulus Office agent $AID of $U (piped)" --uid="$R_UID" --gid="$R_GID" -- \
    /bin/sh -c "$WRAPPER" office-agent "$unit.scope" "$envfile" "$CWD" "${ARGV[@]}"
}

cmd_kill() {
  U="office-u-$RID"
  getent passwd "$U" >/dev/null || return 0
  load_user
  if server_alive; then as_user tmux -S "$SOCK" kill-session -t "=agent-$AID" 2>/dev/null || true; fi
  local unit sandboxed=0
  if own_sandbox; then sandboxed=1; fi
  for unit in $(agent_units); do
    unit_owned "$unit" || die "$unit has processes of another account"
    systemctl kill --signal=SIGKILL -- "$unit" 2>/dev/null || true
  done
  for _ in $(seq 1 100); do
    [[ -z $(agent_units) ]] && break
    sleep 0.05
  done
  for unit in $(agent_units); do systemctl reset-failed -- "$unit" 2>/dev/null || true; done
  if ((sandboxed)); then
    sandbox_lock
    own_sandbox && sandbox_down
  fi
  return 0
}

cmd_list_sessions() {
  load_user
  if server_alive; then as_user tmux -S "$SOCK" list-sessions -F '#{session_name}' 2>/dev/null || true; fi
  local id
  for id in $(sandbox_ids); do
    load_sandbox "$id" || continue
    [[ $S_RID == "$RID" ]] || continue
    SOCK=$(sandbox_sock)
    if server_alive; then as_user tmux -S "$SOCK" list-sessions -F '#{session_name}' 2>/dev/null || true; fi
  done
}

cmd_sockets() {
  load_user
  local unit pid dirs=()
  for unit in $(agent_units); do
    for pid in $(unit_pids "$unit"); do dirs+=("/proc/$pid/fd"); done
  done
  [[ ${#dirs[@]} -gt 0 ]] || return 0
  find "${dirs[@]}" -maxdepth 1 -lname 'socket:*' -printf '%h %l\n' 2>/dev/null |
    sed -n 's|^/proc/\([0-9]*\)/fd socket:\[\([0-9]*\)\]$|\1 \2|p' | sort -u || true
}

# Paste buffer $1 into the pane and delete it. `send-keys` is not used: tmux
# refuses it while a read-only client (a watcher) is attached. text = bracketed
# paste (-p); raw = control keys, -S so tmux >= 3.5 does not sanitize them
# (older tmux has no -S and pastes raw anyway).
paste_buffer() {
  local buf=$1 mode=$2 err
  if [[ $mode == text ]]; then
    err=$(tmux_u paste-buffer -d -p -b "$buf" -t "=$SESSION:" 2>&1) && return 0
  else
    err=$(tmux_u paste-buffer -d -S -b "$buf" -t "=$SESSION:" 2>&1) && return 0
    if [[ $err == *"unknown flag"* || $err == *"usage: paste-buffer"* ]]; then
      err=$(tmux_u paste-buffer -d -b "$buf" -t "=$SESSION:" 2>&1) && return 0
    fi
  fi
  tmux_u delete-buffer -b "$buf" 2>/dev/null || true
  die "paste-buffer failed: $err"
}

cmd_send_keys() {
  load_user
  use_session_sock
  local buf
  buf="office-keys-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
  tmux_u load-buffer -b "$buf" - || die "load-buffer failed"
  # Empty stdin leaves no buffer behind (Enter alone).
  if tmux_u show-buffer -b "$buf" >/dev/null 2>&1; then paste_buffer "$buf" "$PASTE"; fi
  if [[ $ENTER == 1 ]]; then
    printf '\r' | tmux_u load-buffer -b "$buf" - || die "load-buffer failed"
    paste_buffer "$buf" raw
  fi
}

cmd_attach() {
  load_user
  use_session_sock
  sock_ok || die "tmux server of $U is not running" 3
  local term=${TERM:-xterm-256color} ro=()
  [[ $term =~ ^[A-Za-z0-9._+-]{1,64}$ ]] || term=xterm-256color
  [[ $MODE == ro ]] && ro=(-r)
  user_env_args
  exec setpriv --reuid="$R_UID" --regid="$R_GID" --init-groups --no-new-privs -- \
    "${USER_ENV[@]}" TERM="$term" tmux -S "$SOCK" attach-session "${ro[@]}" -t "=$SESSION"
}

cmd_write_file() {
  load_user
  as_user /bin/sh -c 'umask 077; d=$(dirname -- "$1"); mkdir -p -- "$d" &&
    t=$(mktemp "$d/.office-write.XXXXXXXX") && cat >"$t" && chmod "$2" -- "$t" && mv -f -- "$t" "$1" ||
    { rm -f -- "$t"; exit 1; }' office-write "$FPATH" "$FMODE" || die "write-file failed"
}

main() {
  [[ $# -ge 1 ]] || usage
  local verb=$1
  shift
  load_conf
  # 1. Validate every argument (no side effects before this).
  case $verb in
    provision | deprovision | list-sessions)
      [[ $# -eq 1 ]] || usage
      check_rid "$1"
      ;;
    mount-project)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_workdir "$1" "$2"
      WORKDIR=$2
      ;;
    reclaim)
      [[ $# -eq 1 ]] || usage
      check_reclaim_dir "$1"
      RDIR=$1
      ;;
    remove-floor)
      [[ $# -eq 1 ]] || usage
      [[ $1 =~ $SLUG_RE ]] || bad "floor slug"
      SLUG=$1
      ;;
    exec | spawn-piped)
      [[ $# -ge 5 ]] || usage
      check_rid "$1"
      check_aid "$2"
      check_user_path "$3"
      check_argv "${@:4}"
      AID=$2 CWD=$3
      ARGV=("${@:5}")
      ;;
    kill | sockets)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_aid "$2"
      AID=$2
      ;;
    sandbox-up)
      [[ $# -eq 7 ]] || usage
      check_rid "$1"
      check_aid "$2"
      [[ $3 =~ ^(0|[1-9][0-9]{0,4})$ && $3 -le 64999 ]] || bad "sandbox slot"
      [[ $4 =~ ^[1-9][0-9]{7,14}$ ]] || bad "memory limit (bytes, at least 10000000)"
      [[ $5 =~ ^[1-9][0-9]{0,4}$ ]] || bad "cpu limit (percent)"
      [[ $6 =~ ^[1-9][0-9]{1,6}$ ]] || bad "tasks limit"
      [[ $7 =~ $OWNER_RE ]] || bad "owner"
      AID=$2 SLOT=$3 MEM=$4 CPU=$5 TASKS=$6 OWNER=$7
      ;;
    sandbox-list)
      [[ $# -eq 0 ]] || usage
      ;;
    capture)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 =~ ^[0-9]{1,6}$ ]] || bad "line count"
      SESSION=$2 LINES_=$3
      ;;
    pane-title | has-session)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_session "$2"
      SESSION=$2
      ;;
    send-keys)
      [[ $# -eq 4 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 == 0 || $3 == 1 ]] || bad "enter flag"
      [[ $4 == text || $4 == raw ]] || bad "paste mode"
      SESSION=$2 ENTER=$3 PASTE=$4
      ;;
    attach)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_session "$2"
      [[ $3 == ro || $3 == rw ]] || bad "attach mode"
      SESSION=$2 MODE=$3
      ;;
    write-file)
      [[ $# -eq 3 ]] || usage
      check_rid "$1"
      check_user_path "$2"
      [[ $3 =~ ^0?[0-7]{3}$ ]] || bad "mode"
      FPATH=$2 FMODE=$3
      ;;
    read-file | list-dir)
      [[ $# -eq 2 ]] || usage
      check_rid "$1"
      check_user_path "$2"
      FPATH=$2
      ;;
    *) usage ;;
  esac
  RID=${1-}
  # 2. Only then require root.
  [[ $EUID -eq 0 ]] || die "must run as root (sudo -n office-runner-helper ...)"
  case $verb in
    provision) cmd_provision ;;
    deprovision) cmd_deprovision ;;
    mount-project) cmd_mount_project ;;
    reclaim) cmd_reclaim ;;
    remove-floor) cmd_remove_floor ;;
    exec) cmd_exec ;;
    spawn-piped) cmd_spawn_piped ;;
    kill) cmd_kill ;;
    sandbox-up) cmd_sandbox_up ;;
    sandbox-list) cmd_sandbox_list ;;
    sockets) cmd_sockets ;;
    capture) load_user && use_session_sock && tmux_u capture-pane -p -J -t "=$SESSION:" -S "-$LINES_" ;;
    pane-title) load_user && use_session_sock && tmux_u display-message -p -t "=$SESSION:" '#{pane_title}' ;;
    has-session) load_user && use_session_sock && server_alive && as_user tmux -S "$SOCK" has-session -t "=$SESSION" 2>/dev/null ;;
    list-sessions) cmd_list_sessions ;;
    send-keys) cmd_send_keys ;;
    attach) cmd_attach ;;
    write-file) cmd_write_file ;;
    read-file) load_user && as_user /bin/sh -c '[ -f "$1" ] || exit 3; exec cat -- "$1"' office-read "$FPATH" ;;
    list-dir) load_user && as_user /bin/sh -c '[ -d "$1" ] || exit 0; exec find "$1" -mindepth 1 -maxdepth 1 -printf "%f\0"' office-ls "$FPATH" ;;
  esac
}

main "$@"
